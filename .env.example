# Copiar a .env en la raiz del repositorio. Nunca versionar el archivo real.
# True usa correo por consola; en produccion establecer False.
MICOLMENA_DEBUG=True
MICOLMENA_SECRET_KEY=
MICOLMENA_DB_NAME=dbmicolmena
MICOLMENA_DB_USER=
MICOLMENA_DB_PASSWORD=
MICOLMENA_DB_HOST=localhost
MICOLMENA_DB_PORT=3306
MICOLMENA_EMAIL_USER=
MICOLMENA_EMAIL_PASSWORD=
# Compatibilidad con funciones Fernet heredadas. No reutilizar la clave expuesta.
MICOLMENA_TWO_FA_ENCRYPTION_KEY=
